# Which provider adapter to use: hikerapi | apify | mock
PROVIDER=mock

# API key for the chosen provider (not needed for mock)
PROVIDER_API_KEY=

# Path to the Google service account JSON key file (leave blank to disable Sheets sync)
GOOGLE_SERVICE_ACCOUNT_FILE=

# The target Google Sheet's ID (from its URL), leave blank to disable Sheets sync
GOOGLE_SHEET_ID=

# Optional overrides (defaults shown)
ACCOUNTS_CSV_PATH=accounts.csv
HISTORY_CSV_PATH=history.csv
REPORT_XLSX_PATH=daily_report.xlsx
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
